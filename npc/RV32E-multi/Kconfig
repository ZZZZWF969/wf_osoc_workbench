mainmenu "NPC Configuration"

config NPC_TRACE
	bool "Enable tracer"
	default n

config NPC_ITRACE
	depends on NPC_TRACE
	bool "Enable instruction tracer"
	default n

config NPC_MTRACE
	depends on NPC_TRACE
	bool "Enable memory tracer"
	default n

config NPC_WAVE
	bool "Enable waveform"
	default n

config NPC_DIFFTEST
	bool "Enable difftest"
	default n

config NPC_WATCHPOINT
	bool "Enable watchpoint"
	default n
